{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "env": {
    "browser": true,
    "es2021": true
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "off",
    "unicorn/prefer-query-selector": "off"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
