{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "types": []
  },
  "include": ["src", "demo/main.ts"]
}
