{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "dist",
    "types": [],
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src"
  ]
}
