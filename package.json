{
  "name": "yixi-lit-design",
  "author": "yixikkjkj",
  "license": "MIT",
  "version": "0.1.0",
  "description": "基于 Lit（Light DOM + 全局 CSS）的轻量 Web Components 组件库",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js",
      "default": "./dist/all.js"
    },
    "./directives/spread": {
      "types": "./dist/directives/spread.d.ts",
      "import": "./dist/directives/spread.js",
      "default": "./dist/directives/spread.js"
    },
    "./components/*": {
      "types": "./dist/components/*/auto.d.ts",
      "import": "./dist/components/*/auto.js",
      "default": "./dist/components/*/auto.js"
    },
    "./styles.css": {
      "types": "./dist/styles/index.css.d.ts",
      "default": "./dist/styles/index.css"
    },
    "./styles/common.css": {
      "types": "./dist/styles/common.css.d.ts",
      "default": "./dist/styles/common.css"
    },
    "./styles/*.css": {
      "types": "./dist/components/*/style.css.d.ts",
      "default": "./dist/components/*/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rspack serve --mode development",
    "build": "node scripts/build.mjs",
    "lint": "oxlint -c oxlint.json src demo docs",
    "format": "oxfmt src demo docs",
    "format:check": "oxfmt --check src demo docs",
    "typecheck": "tsc --noEmit",
    "test:tree-shaking": "npm run build && node scripts/test-tree-shaking.mjs",
    "test:browser-build": "node scripts/test-browser-build.mjs",
    "test:native-props": "node scripts/test-native-props.mjs",
    "test:formatter-lsp": "node scripts/test-formatter-lsp.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@rspack/dev-server": "^2.2.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/all.js",
    "./dist/components/*/auto.js",
    "**/*.css",
    "./dist/browser/*.js",
    "./src/all.ts",
    "./src/components/*/auto.ts"
  ]
}
